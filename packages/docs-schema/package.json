{
  "name": "@yuheng/docs-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the Yuheng document model: node and mark definitions shared by the Go validator/renderer and the Tiptap editor.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.json": "./schema.json"
  },
  "files": [
    "schema.json",
    "src",
    "golden"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prosemirror-model": "^1.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
