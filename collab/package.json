{
  "name": "@yuheng/collab",
  "version": "0.1.0",
  "private": true,
  "description": "Yuheng docs collaboration service: Yjs sync over WebSocket with authentication, load and persistence delegated to the Go server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.0",
    "ioredis": "^5.6.0",
    "lib0": "^0.2.99",
    "prosemirror-model": "^1.25.0",
    "ws": "^8.18.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
